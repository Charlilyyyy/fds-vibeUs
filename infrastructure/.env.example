# Copy to .env for local overrides (optional).
# Spring Boot services also read these when exported in the shell.
# Do not commit real secrets.

# ----------------------------
# PostgreSQL (docker-compose + JDBC)
# ----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Per-service JDBC URLs (used by auth / user / music)
# AUTH_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vibeus_auth_db
# USER_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vibeus_user_db
# MUSIC_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vibeus_music_db

# ----------------------------
# JWT (shared by auth + gateway)
# ----------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# ----------------------------
# Service URLs (local hybrid mode)
# ----------------------------
USER_SERVICE_URL=http://localhost:8083
GATEWAY_PORT=8081
AUTH_PORT=8082
USER_PORT=8083
MUSIC_PORT=8084

# ----------------------------
# MinIO (music-service)
# ----------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# ----------------------------
# Kafka (user-service producer)
# ----------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----------------------------
# Redis (provisioned; unused in MVP app code)
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
